# Copy to .env and replace every CHANGE_ME value before first start.
# Paths are host paths. Storage must already be mounted before Compose starts.

COMPOSE_PROJECT_NAME=emulator
ROMM_IMAGE=rommapp/romm:latest
MARIADB_IMAGE=mariadb:11.8

# Tailscale-only HTTPS endpoint. Do not publish this hostname in public DNS.
ROMM_BASE_URL=https://romm.tailnet-name.ts.net
ROMM_PORT=8080

# Local game-disk layout. The library is exposed inside RomM as library/roms/,
# which uses RomM's standard roms/{platform}/{game} scanner layout safely.
GAMES_MOUNT=/mnt/games/Sophia/games
ROM_LIBRARY_PATH=/mnt/games/Sophia/games
ROMM_ASSETS_PATH=/mnt/games/Sophia/games/saves/romm-assets
BACKUP_ROOT=/mnt/games/Sophia/games/backups/romm-assets
STORAGE_TYPE=local
EXPECTED_FS_TYPE=ext4
# NAS_SERVER and NAS_SHARE are required only when STORAGE_TYPE=cifs.
NAS_SERVER=
NAS_SHARE=
NAS_MARKER=.emulator-nas-marker
SAVE_BACKUP_RETENTION=20

# Local application-host state. Keep databases and the RomM Redis/Valkey data off SMB/CIFS.
APP_DATA_PATH=/srv/emulator
WEBSTATION_CONFIG_PATH=/srv/emulator/webstation
# Official Retro Rewind releases and generated Riivolution descriptor. This is
# mounted read-only in WebStation; saves remain under WEBSTATION_CONFIG_PATH.
RETRO_REWIND_INSTALL_ROOT=/srv/emulator/retro-rewind
XEMU_FIRMWARE_PATH=/mnt/games/Sophia/games/bios/xemu

# Optional LinuxServer Steam service (`docker compose --profile steam ...`).
# The host library is mounted read-only; /config owns login state, Steam Cloud
# data, shader caches and independent Proton prefixes.
STEAM_IMAGE=lscr.io/linuxserver/steam@sha256:f3d8f5e8c80c5ce809c839ada788fd69132b2314fcad2e7804ca725671aa5c65
STEAM_CONFIG_PATH=/srv/emulator/steam
STEAM_HOST_LIBRARY_PATH=/home/service/snap/steam/common/.local/share/Steam
STEAM_CATALOG_PATH=/mnt/games/Sophia/games/Steam
STEAM_WEB_PASSWORD_FILE=/srv/emulator/steam-web-password
STEAM_WEB_USER=steam
STEAM_HTTP_PORT=3020
STEAM_PUID=1000
STEAM_PGID=1000

# Retro Rewind is scoped to its dedicated launcher. 3x gives Dolphin a
# 1920x1584 internal image before Selkies scales it to the 1280x720 canvas.
RETRO_REWIND_VIDEO_BACKEND=Vulkan
RETRO_REWIND_INTERNAL_RESOLUTION=3

# Required secrets. Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_PASSWORD=CHANGE_ME

# Optional metadata providers. Leave blank to scan without enrichment.
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
STEAM_API_ENABLED=true
