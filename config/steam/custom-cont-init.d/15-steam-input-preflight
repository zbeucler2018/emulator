"""Repair the known Black Flag Steam Input override before Steam starts."""

import argparse
import os
from pathlib import Path
import re


DEFAULT_LOCALCONFIG = Path(
    "/config/.local/share/Steam/userdata/1601339192/config/localconfig.vdf"
)
BLACK_FLAG_APPID = "242050"


def _block(text: str, key: str, start: int = 0, end: int | None = None) -> tuple[int, int] | None:
    """Return the contents of a VDF object identified by an exact line key."""
    limit = len(text) if end is None else end
    match = re.search(
        rf'(?m)^[ \t]*"{re.escape(key)}"[ \t]*\r?$',
        text[start:limit],
    )
    if match is None:
        return None
    key_end = start + match.end()
    opening = text.find("{", key_end, limit)
    if opening < 0 or text[key_end:opening].strip():
        return None

    depth = 0
    quoted = False
    escaped = False
    for index in range(opening, limit):
        character = text[index]
        if quoted:
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                quoted = False
            continue
        if character == '"':
            quoted = True
        elif character == "{":
            depth += 1
        elif character == "}":
            depth -= 1
            if depth == 0:
                return opening + 1, index
    return None


def repair_black_flag_steam_input(path: Path) -> bool:
    """Change only Black Flag's explicit Steam Input disable from 0 to 2."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return False

    cursor = 0
    setting: re.Match[str] | None = None
    app_start = 0
    while apps := _block(text, "apps", cursor):
        app = _block(text, BLACK_FLAG_APPID, *apps)
        if app is not None:
            candidate = re.search(
                r'("UseSteamControllerConfig"[ \t]+)"(?P<value>\d+)"',
                text[app[0] : app[1]],
            )
            if candidate is not None:
                setting = candidate
                app_start = app[0]
                break
        cursor = apps[1] + 1
    if setting is None or setting.group("value") != "0":
        return False

    value_start = app_start + setting.start("value")
    value_end = app_start + setting.end("value")
    updated = text[:value_start] + "2" + text[value_end:]

    metadata = path.stat()
    temporary = path.with_name(f".{path.name}.steam-input-{os.getpid()}")
    try:
        temporary.write_text(updated, encoding="utf-8")
        os.chmod(temporary, metadata.st_mode)
        os.chown(temporary, metadata.st_uid, metadata.st_gid)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path", nargs="?", type=Path, default=DEFAULT_LOCALCONFIG)
    args = parser.parse_args()
    if repair_black_flag_steam_input(args.path):
        print(
            "steam-input-preflight: restored Steam Input for Black Flag "
            "(UseSteamControllerConfig=2)",
            flush=True,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
