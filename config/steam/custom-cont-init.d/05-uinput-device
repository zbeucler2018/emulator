#!/usr/bin/with-contenv bash
set -euo pipefail

# Give only the unprivileged desktop user a private node for the host uinput
# driver. The container never receives the host's physical /dev/input tree.
if [[ ! -e /dev/uinput ]]; then
  mknod /dev/uinput c 10 223
fi
chown abc:abc /dev/uinput
chmod 0600 /dev/uinput

# Docker's private /dev does not receive the event nodes created by uinput.
# Reserve only slot 0's verified next-free nodes; never expose the existing
# host event0-event20 or js0 devices to this container.
for node in event21 js1; do
  if [[ -e "/sys/class/input/$node" ]]; then
    echo "Refusing to expose occupied host input node $node" >&2
    exit 1
  fi
done

rm -f /dev/input/event21 /dev/input/js1
mknod /dev/input/event21 c 13 85
mknod /dev/input/js1 c 13 1
chown abc:abc /dev/input/event21 /dev/input/js1
chmod 0600 /dev/input/event21 /dev/input/js1
